# Copy to .env (`make env`). Read by docker compose, and exported by the Makefile for
# services you run locally with `make run-<service>`. Never commit the real .env.

# Shared by user-service (signs tokens) and api-gateway (verifies them). At least 32 bytes.
JWT_SECRET=change-me-dev-only-jwt-secret-at-least-32-bytes

# Create the demo accounts admin/admin123 (Manager) and employee/employee123 on first start.
SEED_DEMO_DATA=true

# Optional third-party integrations; leave empty to disable.
VOUCHERY_API_KEY=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_CLUB_ID=
