# Server-side environment variables — copy this file to `.env` and fill in real
# values for your environment. Never commit `.env`.

# ===== MySQL (user-service) =====
DB_URL=jdbc:mysql://localhost:3306/ProfileService
DB_USERNAME=root
DB_PASSWORD=mysql

# ===== MongoDB (request-service, rewardPoint-service) =====
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_AUTH_DB=admin
MONGO_USERNAME=mongo
MONGO_PASSWORD=mongo
MONGO_DATABASE=RequestDB
# (RewardPointService uses RewardPointDB by default — override per service)

# ===== RabbitMQ (user-service) =====
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ===== JWT (user-service) =====
# Must be at least 16 bytes; 32+ bytes recommended.
JWT_SECRET=change-me-in-production-please-use-32-bytes-minimum

# ===== External services =====
VOUCHERY_API_URL=https://university-of-science.sandbox.vouchery.app/api/v2.1/customers
VOUCHERY_API_KEY=
