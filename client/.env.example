# Used by `npm start` / `make dev-client` (Docker builds get these from the root .env).
# Every backend call goes through the API gateway.
REACT_APP_API_GATEWAY_URL=http://localhost:8080

# Strava (optional, Activities page). The client id is public; the client secret is
# configured on the server (STRAVA_CLIENT_SECRET in the root .env), never here.
REACT_APP_STRAVA_CLIENT_ID=
REACT_APP_STRAVA_CLUB_ID=
REACT_APP_STRAVA_REDIRECT_URI=http://localhost:3000/activities
