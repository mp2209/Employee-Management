# API Gateway base URL — every backend call goes through here.
REACT_APP_API_GATEWAY_URL=http://localhost:8080

# Vouchery integration (used by Voucher + Profile containers)
REACT_APP_VOUCHERY_API_URL=https://university-of-science.sandbox.vouchery.app
REACT_APP_VOUCHERY_API_KEY=

# Strava OAuth (used by Activities)
# client_id is public. Do NOT put client_secret here — it must be
# exchanged server-side.
REACT_APP_STRAVA_CLIENT_ID=
REACT_APP_STRAVA_REDIRECT_URI=http://localhost:3000/activities
